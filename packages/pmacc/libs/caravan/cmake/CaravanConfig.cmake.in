@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/CaravancoreTargets.cmake")

foreach(_caravan_component IN LISTS Caravan_FIND_COMPONENTS)
    if(_caravan_component STREQUAL "core")
        set(Caravan_core_FOUND TRUE)
    elseif(_caravan_component STREQUAL "mpi" AND @CARAVAN_BUILD_MPI@)
        if(Caravan_FIND_REQUIRED_mpi)
            find_dependency(MPI COMPONENTS CXX)
        else()
            find_package(MPI QUIET COMPONENTS CXX)
        endif()
        if(MPI_CXX_FOUND)
            include("${CMAKE_CURRENT_LIST_DIR}/CaravanmpiTargets.cmake")
            set(Caravan_mpi_FOUND TRUE)
        else()
            set(Caravan_mpi_FOUND FALSE)
        endif()
    else()
        set(Caravan_${_caravan_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(Caravan)
