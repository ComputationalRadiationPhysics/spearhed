#pragma once

#include <cstddef>
#include <cstdint>

namespace spearhed
{
    /* We have to hold back 350MiB for gpu-internal operations:
     *   - random number generator
     *   - reduces
     *   - ...
     */
    constexpr size_t reservedGpuMemorySize = 700 * 1024 * 1024;

    /** number of slots for particles within a frame */
    static constexpr uint32_t numFrameSlots = 64;

} // namespace spearhed
