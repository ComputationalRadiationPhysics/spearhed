#pragma once

#include "spearhed/ParticleView.hpp"
#include "spearhed/topology/PointStorage.hpp"

namespace llama_lite::traits
{

    template<>
    struct AsType<spearhed::posField>
    {
        using type = spearhed::
            Point<spearhed::CS, spearhed::PointViewStorage<spearhed::CS, spearhed::ParticleView<spearhed::pos>>>;

        constexpr type operator()(auto fieldView) const
        {
            return type{fieldView};
        }
    };

} // namespace llama_lite::traits
